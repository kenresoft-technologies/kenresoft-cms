{
  "name": "kenresoft-cms",
  "version": "0.10.0",
  "private": true,
  "description": "Cloudflare-native, API-first, reusable CMS. Single-site-per-deployment, self-hostable.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test && pnpm run test:scripts",
    "test:scripts": "node --test \"scripts/lib/**/*.test.mjs\"",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "rename-worker": "node scripts/rename-worker.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "esbuild": "^0.28.1",
      "miniflare>undici": "^7.29.0",
      "sharp": "^0.35.4",
      "ws": "^8.21.0",
      "js-yaml": "^4.3.2"
    }
  }
}
