---
import Layout from '../../layouts/Layout.astro';

// This starter defaults to output: 'server' (astro.config.mjs), so every route already renders
// on demand and this line is a no-op today. If you ever switch to output: 'static', keep this —
// without it, a dynamic route only gets a real page for whatever getStaticPaths() returned at
// build time, so a draft's slug (never in that list) 404s before this page's code even runs,
// breaking Live Preview regardless of the automatic previewToken handling below. See
// docs/ASTRO.md's "Live Preview requires the page to render on demand" section (in the
// Kenresoft CMS repo).
export const prerender = false;

// Astro.locals.cms (middleware.ts) is already bound to this request's own ?preview_token= if
// one is present — the Entry Editor's "Live Preview" button appends it — so this plain
// entries.get() call transparently renders a draft (or any status) through this same template
// instead of 404ing, with no branch needed here. previewToken is still read directly below only
// to decide whether to show the banner.
const cms = Astro.locals.cms;
const { slug } = Astro.params;
const previewToken = Astro.url.searchParams.get('preview_token');
const post = slug ? await cms.entries.get({ contentType: 'blog-post', slug }) : null;

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const title = String(post.data.title ?? post.slug);
// Adjust this to match your own content type's field names — 'body' is just this template's
// placeholder for a rich-text/HTML field. Only set:html content you trust (i.e. authored by a
// signed-in CMS editor, never raw user input) — see docs/ARCHITECTURE.md's Tiptap notes.
const body = typeof post.data.body === 'string' ? post.data.body : '';
---

<Layout title={title}>
  {previewToken ? (
    <p style="background:#fef3c7;color:#92400e;padding:0.5rem 1rem;border-radius:4px;">
      Preview mode — viewing a {post.status} entry.
    </p>
  ) : null}
  <a href="/blog/">&larr; Back to Blog</a>
  <h1>{title}</h1>
  {body && <div set:html={body} />}
</Layout>
