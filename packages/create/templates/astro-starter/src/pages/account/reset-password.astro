---
import Layout from '../../layouts/Layout.astro';

const token = Astro.url.searchParams.get('token');
---

<Layout title="Reset password">
  <h1>Reset your password</h1>

  {!token && <p role="alert">This reset link is missing its token. <a href="/account/forgot-password">Request a new one</a>.</p>}

  {token && (
    <form id="reset-form" data-token={token}>
      <label>New password <input type="password" name="newPassword" required minlength="8" autocomplete="new-password" /></label>
      <button type="submit">Reset password</button>
    </form>
  )}

  <p id="message" role="alert" hidden></p>
</Layout>

<script>
  import { browserCms, KenresoftApiError } from '../../lib/browser-cms';

  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const message = document.getElementById('message') as HTMLElement;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      await browserCms.auth.resetPassword({
        token: form.dataset.token ?? '',
        newPassword: String(new FormData(form).get('newPassword')),
      });
      form.hidden = true;
      message.innerHTML = 'Password updated. <a href="/account/login">Log in</a>';
    } catch (err) {
      message.textContent = err instanceof KenresoftApiError ? err.message : 'Could not reset your password.';
    }
    message.hidden = false;
  });
</script>
