---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Forgot password">
  <h1>Forgot your password?</h1>
  <p>Enter your email and we'll send a reset link if an account exists for it.</p>

  <form id="forgot-form">
    <label>Email <input type="email" name="email" required autocomplete="email" /></label>
    <button type="submit">Send reset link</button>
  </form>

  <p id="message" role="alert" hidden></p>
  <p><a href="/account/login">Back to log in</a></p>
</Layout>

<script>
  import { browserCms, KenresoftApiError } from '../../lib/browser-cms';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const message = document.getElementById('message') as HTMLElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      // Always the same generic reply, whether or not the email has an account.
      const result = await browserCms.auth.requestPasswordReset({
        email: String(new FormData(form).get('email')),
        redirectUrl: `${window.location.origin}/account/reset-password`,
      });
      message.textContent = result.message;
    } catch (err) {
      message.textContent = err instanceof KenresoftApiError ? err.message : 'Something went wrong. Please try again.';
    }
    message.hidden = false;
  });
</script>
