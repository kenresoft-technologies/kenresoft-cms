# Your CMS API's URL (the deployed API Worker, or http://localhost:8787 while running the CMS locally).
PUBLIC_KENRESOFT_CMS_URL=http://localhost:8787

# Optional: Cloudflare Turnstile site key for the register form. Also set the TURNSTILE_SECRET_KEY
# secret on the CMS API. Leave unset for no human check.
# PUBLIC_TURNSTILE_SITE_KEY=
