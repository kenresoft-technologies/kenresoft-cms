{
  "name": "@kenresoft-cms/contracts",
  "version": "0.1.2",
  "type": "module",
  "description": "Zod schemas and API contract shared between Kenresoft CMS's API Worker and Admin Worker.",
  "license": "MIT",
  "homepage": "https://github.com/kenresoft-technologies/kenresoft-cms/tree/main/packages/contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenresoft-technologies/kenresoft-cms.git",
    "directory": "packages/contracts"
  },
  "bugs": "https://github.com/kenresoft-technologies/kenresoft-cms/issues",
  "main": "./api/index.ts",
  "types": "./api/index.ts",
  "exports": {
    ".": "./api/index.ts",
    "./schemas/enums": "./schemas/enums.ts"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/api/index.js",
    "types": "./dist/api/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/api/index.d.ts",
        "import": "./dist/api/index.js"
      },
      "./schemas/enums": {
        "types": "./dist/schemas/enums.d.ts",
        "import": "./dist/schemas/enums.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kenresoft-cms/config": "workspace:*",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
