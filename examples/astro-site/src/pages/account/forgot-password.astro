---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Alert from '../../components/ui/Alert.astro';
---

<BaseLayout title="Forgot password — Kenresoft CMS" noIndex>
  <div class="auth-page">
    <h1>Forgot your password?</h1>
    <p class="auth-lede">Enter your email and we'll send a reset link if an account exists for it.</p>

    <form id="forgot-form" novalidate>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>

      <Alert tone="error" id="forgot-error" hidden />
      <Alert tone="success" id="forgot-success" hidden>
        If that email is registered, a reset link has been sent.
      </Alert>

      <button type="submit" class="button button-primary" id="forgot-submit">Send reset link</button>
    </form>

    <p class="auth-links"><a href="/account/login">Back to log in</a></p>
  </div>
</BaseLayout>

<script>
  import { getBrowserClient, KenresoftApiError } from '../../lib/browser-client';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const errorEl = document.getElementById('forgot-error') as HTMLElement;
  const successEl = document.getElementById('forgot-success') as HTMLElement;
  const submitButton = document.getElementById('forgot-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;
    successEl.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';

    const data = new FormData(form);
    try {
      // Always resolves with the identical generic message regardless of whether the email
      // matches an account — this deployment's own account-enumeration-resistance guarantee,
      // rendered here exactly as the API worded it rather than a locally-invented message.
      const result = await getBrowserClient().commerce.customerAuth.requestPasswordReset({ email: String(data.get('email')) });
      successEl.textContent = result.message;
      successEl.hidden = false;
      form.reset();
    } catch (err) {
      errorEl.textContent = err instanceof KenresoftApiError ? err.message : 'Something went wrong. Please try again.';
      errorEl.hidden = false;
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send reset link';
    }
  });
</script>

<style>
  .auth-page {
    max-width: 420px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-20);
  }

  .auth-page h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-3xl);
    font-weight: 600;
    text-align: center;
  }

  .auth-lede {
    margin: 0 0 var(--space-8);
    color: var(--ink-muted);
    text-align: center;
    font-size: var(--text-sm);
  }

  form {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  #forgot-submit {
    width: 100%;
    margin-top: var(--space-2);
  }

  .auth-links {
    text-align: center;
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .auth-links a {
    color: var(--brand);
    font-weight: 600;
    text-decoration: none;
  }

  .auth-links a:hover {
    text-decoration: underline;
  }
</style>
