---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Alert from '../../components/ui/Alert.astro';

const token = Astro.url.searchParams.get('token');
---

<BaseLayout title="Reset password — Kenresoft CMS" noIndex>
  <div class="auth-page">
    <h1>Reset your password</h1>

    {
      !token ? (
        <Alert tone="error">
          This link is missing its reset token. Use the link from your password-reset email, or
          <a href="/account/forgot-password">request a new one</a>.
        </Alert>
      ) : (
        <>
          <form id="reset-form" novalidate>
            <input type="hidden" name="token" value={token} />
            <label class="field">
              <span>New password</span>
              <input type="password" name="newPassword" required minlength="8" autocomplete="new-password" />
              <span class="hint">At least 8 characters.</span>
            </label>

            <Alert tone="error" id="reset-error" hidden />
            <Alert tone="success" id="reset-success" hidden>
              Password reset. Every existing session was signed out — you can log in now.
            </Alert>

            <button type="submit" class="button button-primary" id="reset-submit">Reset password</button>
          </form>
          <p class="auth-links"><a href="/account/login">Back to log in</a></p>
        </>
      )
    }
  </div>
</BaseLayout>

<script>
  import { getBrowserClient, KenresoftApiError } from '../../lib/browser-client';

  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('reset-error') as HTMLElement | null;
  const successEl = document.getElementById('reset-success') as HTMLElement | null;
  const submitButton = document.getElementById('reset-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!errorEl || !successEl || !submitButton) return;
    errorEl.hidden = true;
    successEl.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Resetting…';

    const data = new FormData(form);
    try {
      await getBrowserClient().commerce.customerAuth.confirmPasswordReset({
        token: String(data.get('token')),
        newPassword: String(data.get('newPassword')),
      });
      successEl.hidden = false;
      form.hidden = true;
    } catch (err) {
      errorEl.textContent = err instanceof KenresoftApiError ? err.message : 'Could not reset your password.';
      errorEl.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = 'Reset password';
    }
  });
</script>

<style>
  .auth-page {
    max-width: 420px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  .auth-page h1 {
    margin: 0 0 1.75rem;
    font-size: 1.75rem;
    font-weight: 600;
    text-align: center;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .field input {
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    font: inherit;
  }

  .hint {
    font-weight: 400;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  #reset-submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  #reset-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .auth-links {
    text-align: center;
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .auth-links a {
    color: var(--brand);
    text-decoration: none;
  }
</style>
