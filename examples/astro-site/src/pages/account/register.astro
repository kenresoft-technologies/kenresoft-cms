---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Alert from '../../components/ui/Alert.astro';
import { createServerClient } from '../../lib/site-client';
import { sanitizeRedirect } from '../../lib/redirect';

const redirectTo = sanitizeRedirect(Astro.url.searchParams.get('redirect'));
const cms = createServerClient(Astro.request.headers.get('cookie'));
const existingCustomer = await cms.commerce.customer.get().catch(() => null);
if (existingCustomer) {
  return Astro.redirect(redirectTo);
}
---

<BaseLayout title="Register — Kenresoft CMS" noIndex>
  <div class="auth-page">
    <h1>Create an account</h1>

    <form id="register-form" novalidate>
      <label class="field">
        <span>Full name</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="field">
        <span>Password</span>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
        <span class="hint">At least 8 characters.</span>
      </label>

      <Alert tone="error" id="register-error" hidden />

      <button type="submit" class="button button-primary" id="register-submit">Create account</button>
    </form>

    <p class="auth-links">
      Already have an account? <a href={`/account/login?redirect=${encodeURIComponent(redirectTo)}`}>Log in</a>
    </p>
  </div>
</BaseLayout>

<script>
  import { getBrowserClient, KenresoftApiError } from '../../lib/browser-client';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorEl = document.getElementById('register-error') as HTMLElement;
  const submitButton = document.getElementById('register-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Creating account…';

    const data = new FormData(form);
    try {
      await getBrowserClient().commerce.customerAuth.register({
        name: String(data.get('name')),
        email: String(data.get('email')),
        password: String(data.get('password')),
      });
      const redirectTo = new URLSearchParams(window.location.search).get('redirect');
      window.location.href = redirectTo && redirectTo.startsWith('/') && !redirectTo.startsWith('//') ? redirectTo : '/account';
    } catch (err) {
      // 409 here deliberately DOES reveal "an account with that email already exists" — a
      // documented usability-over-enumeration-resistance tradeoff at this one endpoint only
      // (packages/plugin-ecommerce/src/routes/customer-auth.ts) — login/password-reset never do.
      errorEl.textContent = err instanceof KenresoftApiError ? err.message : 'Could not create your account.';
      errorEl.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = 'Create account';
    }
  });
</script>

<style>
  .auth-page {
    max-width: 420px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  .auth-page h1 {
    margin: 0 0 1.75rem;
    font-size: 1.75rem;
    font-weight: 600;
    text-align: center;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .field input {
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    font: inherit;
  }

  .hint {
    font-weight: 400;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  #register-submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  #register-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .auth-links {
    text-align: center;
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .auth-links a {
    color: var(--brand);
    text-decoration: none;
  }
</style>
