---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/account/AccountNav.astro';

// Identity/data load client-side, not via SSR — see lib/account-guard.ts's comment for why an
// SSR cookie-forwarding check can't reliably answer "is this visitor signed in" once the Astro
// site and the CMS API are different origins (the common case).
---

<BaseLayout title="My account — Kenresoft CMS" noIndex>
  <div class="account-page">
    <AccountNav active="dashboard" />
    <div class="account-content">
      <div id="account-loading" class="loading-note">Loading…</div>
      <div id="account-body" hidden>
        <h1 id="account-greeting"></h1>
        <p class="account-summary" id="account-summary"></p>
        <p id="verify-resend-row" class="verify-resend-row" hidden>
          <button type="button" class="button button-secondary" id="verify-resend-button">Resend verification email</button>
          <span id="verify-resend-status" class="verify-resend-status"></span>
        </p>

        <section class="account-section">
          <div class="section-header">
            <h2>Recent orders</h2>
            <a href="/account/orders">View all →</a>
          </div>
          <div id="account-orders"></div>
        </section>

        <section class="account-section">
          <h2>Quick links</h2>
          <div class="quick-links">
            <a href="/account/addresses" class="button button-secondary">Manage addresses</a>
            <a href="/account/settings" class="button button-secondary">Account settings</a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { requireCustomerClientSide } from '../../lib/account-guard';
  import { getBrowserClient, KenresoftApiError } from '../../lib/browser-client';

  const loadingEl = document.getElementById('account-loading') as HTMLElement;
  const bodyEl = document.getElementById('account-body') as HTMLElement;
  const greetingEl = document.getElementById('account-greeting') as HTMLElement;
  const summaryEl = document.getElementById('account-summary') as HTMLElement;
  const ordersEl = document.getElementById('account-orders') as HTMLElement;
  const resendRowEl = document.getElementById('verify-resend-row') as HTMLElement;
  const resendButtonEl = document.getElementById('verify-resend-button') as HTMLButtonElement;
  const resendStatusEl = document.getElementById('verify-resend-status') as HTMLElement;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  (async () => {
    const customer = await requireCustomerClientSide('/account');
    if (!customer) return; // already redirecting to /account/login

    loadingEl.hidden = true;
    bodyEl.hidden = false;
    greetingEl.textContent = `Welcome back, ${customer.name.split(' ')[0]}`;

    summaryEl.textContent = customer.email;
    if (!customer.emailVerified) {
      const span = document.createElement('span');
      span.className = 'unverified';
      span.textContent = ' (email not verified)';
      summaryEl.appendChild(span);
      resendRowEl.hidden = false;
    }

    resendButtonEl.addEventListener('click', async () => {
      resendButtonEl.disabled = true;
      resendStatusEl.textContent = 'Sending…';
      try {
        await getBrowserClient().commerce.customerAuth.resendVerificationEmail({ email: customer.email });
        resendStatusEl.textContent = 'Verification email sent — check your inbox.';
      } catch (err) {
        resendStatusEl.textContent = err instanceof KenresoftApiError ? err.message : 'Could not send the email. Please try again.';
        resendButtonEl.disabled = false;
      }
    });

    try {
      const orders = await getBrowserClient().commerce.customer.orders.list();
      const recentOrders = orders.slice(0, 5);
      ordersEl.innerHTML =
        recentOrders.length === 0
          ? '<p class="empty-note">No orders yet. <a href="/shop">Browse the shop →</a></p>'
          : `<ul class="order-list">${recentOrders
              .map(
                (order) =>
                  `<li><a href="/account/orders/${order.id}">Order #${order.id.slice(0, 8)} — ${escapeHtml(order.status)} — ${new Date(order.createdAt).toLocaleDateString()}</a></li>`,
              )
              .join('')}</ul>`;
    } catch {
      ordersEl.innerHTML = '<p class="empty-note">No orders yet. <a href="/shop">Browse the shop →</a></p>';
    }
  })();
</script>

<style>
  .account-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-20);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-10);
  }

  @media (max-width: 720px) {
    .account-page {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .account-content h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-3xl);
    font-weight: 600;
  }

  .account-summary {
    margin: 0 0 var(--space-8);
    color: var(--ink-muted);
  }

  .unverified {
    color: var(--warning);
    font-weight: 600;
  }

  .verify-resend-row {
    margin: 0 0 var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .verify-resend-status {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .account-section {
    margin-bottom: var(--space-8);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .section-header h2,
  .account-section > h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .section-header a {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
  }

  .section-header a:hover {
    text-decoration: underline;
  }

  .empty-note {
    color: var(--ink-muted);
  }

  .order-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .order-list a {
    display: block;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .order-list a:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
