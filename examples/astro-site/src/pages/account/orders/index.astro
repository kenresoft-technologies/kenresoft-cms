---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccountNav from '../../../components/account/AccountNav.astro';

// Identity/data load client-side, not via SSR — see lib/account-guard.ts's comment for why an
// SSR cookie-forwarding check can't reliably answer "is this visitor signed in" once the Astro
// site and the CMS API are different origins (the common case).
---

<BaseLayout title="My orders — Kenresoft CMS" noIndex>
  <div class="account-page">
    <AccountNav active="orders" />
    <div class="account-content">
      <h1>Orders</h1>

      <div id="orders-loading" class="loading-note">Loading…</div>
      <p id="orders-empty" hidden class="empty-note">No orders yet. <a href="/shop">Browse the shop →</a></p>

      <div class="orders-table-wrap" id="orders-table-wrap" hidden>
        <table class="orders-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Date</th>
              <th>Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody id="orders-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getBrowserClient } from '../../../lib/browser-client';
  import { requireCustomerClientSide } from '../../../lib/account-guard';
  import { formatMoney } from '../../../lib/money';

  const loadingEl = document.getElementById('orders-loading') as HTMLElement;
  const emptyEl = document.getElementById('orders-empty') as HTMLElement;
  const tableWrapEl = document.getElementById('orders-table-wrap') as HTMLElement;
  const tbodyEl = document.getElementById('orders-tbody') as HTMLElement;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  // Mirrors components/commerce/OrderStatusBadge.astro's labels/classes — that component is
  // server-rendered only, so this client-rendered table reproduces its output by hand instead.
  const statusLabels: Record<string, string> = {
    pending: 'Awaiting payment',
    paid: 'Paid',
    fulfilled: 'Fulfilled',
    cancelled: 'Cancelled',
    refunded: 'Refunded',
  };

  (async () => {
    const customer = await requireCustomerClientSide('/account/orders');
    if (!customer) return; // already redirecting to /account/login

    try {
      const orders = await getBrowserClient().commerce.customer.orders.list();
      loadingEl.hidden = true;
      if (orders.length === 0) {
        emptyEl.hidden = false;
        return;
      }
      tableWrapEl.hidden = false;
      tbodyEl.innerHTML = orders
        .map(
          (order) => `
        <tr>
          <td><a href="/account/orders/${order.id}">#${order.id.slice(0, 8)}</a></td>
          <td>${new Date(order.createdAt).toLocaleDateString()}</td>
          <td><span class="order-status order-status-${escapeHtml(order.status)}">${escapeHtml(statusLabels[order.status] ?? order.status)}</span></td>
          <td>${formatMoney(order.totalAmount, order.currency)}</td>
        </tr>`,
        )
        .join('');
    } catch {
      loadingEl.hidden = true;
      emptyEl.hidden = false;
    }
  })();
</script>

<style>
  .account-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-20);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-10);
  }

  @media (max-width: 720px) {
    .account-page {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .account-content h1 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
    font-weight: 600;
  }

  .empty-note {
    color: var(--ink-muted);
  }

  .orders-table-wrap {
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .orders-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }

  .orders-table th {
    text-align: left;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border);
  }

  .orders-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .orders-table tr:last-child td {
    border-bottom: none;
  }

  .orders-table tr:hover td {
    background: var(--surface-muted);
  }

  .orders-table a {
    color: var(--brand);
    text-decoration: none;
    font-weight: 600;
  }

  .order-status {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .order-status-pending {
    background: var(--warning-bg);
    color: color-mix(in oklch, var(--warning) 65%, var(--ink));
  }

  .order-status-paid,
  .order-status-fulfilled {
    background: var(--success-bg);
    color: color-mix(in oklch, var(--success) 60%, var(--ink));
  }

  .order-status-cancelled,
  .order-status-refunded {
    background: var(--surface-muted);
    color: var(--ink-muted);
  }
</style>
