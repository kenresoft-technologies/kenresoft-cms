---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccountNav from '../../../components/account/AccountNav.astro';
import OrderStatusBadge from '../../../components/commerce/OrderStatusBadge.astro';
import { createServerClient, requireCustomerOrRedirect } from '../../../lib/site-client';
import { formatMoney } from '../../../lib/money';

const result = await requireCustomerOrRedirect(Astro.request, '/account/orders');
if ('redirect' in result) return Astro.redirect(result.redirect);

const cms = createServerClient(Astro.request.headers.get('cookie'));
const orders = await cms.commerce.customer.orders.list().catch(() => []);
---

<BaseLayout title="My orders — Kenresoft CMS" noIndex>
  <div class="account-page">
    <AccountNav active="orders" />
    <div class="account-content">
      <h1>Orders</h1>

      {
        orders.length === 0 ? (
          <p class="empty-note">No orders yet. <a href="/shop">Browse the shop →</a></p>
        ) : (
          <table class="orders-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {orders.map((order) => (
                <tr>
                  <td>
                    <a href={`/account/orders/${order.id}`}>#{order.id.slice(0, 8)}</a>
                  </td>
                  <td>{new Date(order.createdAt).toLocaleDateString()}</td>
                  <td>
                    <OrderStatusBadge status={order.status} />
                  </td>
                  <td>{formatMoney(order.totalAmount, order.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .account-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
  }

  @media (max-width: 720px) {
    .account-page {
      grid-template-columns: 1fr;
    }
  }

  .account-content h1 {
    margin: 0 0 1.5rem;
    font-size: 1.75rem;
    font-weight: 600;
  }

  .empty-note {
    color: var(--ink-muted);
  }

  .orders-table {
    width: 100%;
    border-collapse: collapse;
  }

  .orders-table th {
    text-align: left;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .orders-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .orders-table a {
    color: var(--brand);
    text-decoration: none;
    font-weight: 600;
  }
</style>
