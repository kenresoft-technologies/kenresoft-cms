---
import { createKenresoftClient } from '@kenresoft-cms/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cms = createKenresoftClient({ url: import.meta.env.PUBLIC_KENRESOFT_CMS_URL });

// "blog-post" is this content type's slug, not its display name — set when it's created in
// the admin (Content types → New). Change this if your deployment uses a different slug, or
// if you're demonstrating a different content type entirely.
const entries = await cms.entries.list({ contentType: 'blog-post' });

// Real alt text via the public media-metadata endpoint (closes the gap noted in docs/ASTRO.md's
// Known limitations, previously worked around by falling back to the entry's title for every
// image). Fetched once per unique featuredImage id rather than per entry, since several posts
// could share the same image.
const featuredImageIds = [...new Set(entries.map((entry) => entry.data.featuredImage).filter((id) => typeof id === 'string'))];
const featuredImageAltById = new Map(
  await Promise.all(
    featuredImageIds.map(async (id) => [id, (await cms.media.get({ id }))?.altText ?? null] as const),
  ),
);
---

<BaseLayout title="Blog — Kenresoft CMS" description="Updates and posts published through Kenresoft CMS.">
  <div class="page-header">
    <h1>Blog</h1>
  </div>

  {
    entries.length === 0 ? (
      <div class="empty-state">
        <p>
          No published entries yet for the <code>blog-post</code> content type. Create one in
          the admin, publish it, then rebuild this site.
        </p>
      </div>
    ) : (
      <div class="post-list">
        {entries.map((entry) => {
          const title = String(entry.data.title ?? entry.slug);
          return (
            <a class="post-row" href={`/blog/${entry.slug}`}>
              {typeof entry.data.featuredImage === 'string' ? (
                <img
                  src={cms.media.url({ id: entry.data.featuredImage })}
                  alt={featuredImageAltById.get(entry.data.featuredImage) ?? title}
                />
              ) : null}
              <div class="post-row-body">
                <h2>{title}</h2>
                {entry.data.excerpt ? <p>{String(entry.data.excerpt)}</p> : null}
              </div>
            </a>
          );
        })}
      </div>
    )
  }
</BaseLayout>

<style>
  .page-header {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 1rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .empty-state {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem 5rem;
    color: var(--ink-muted);
  }

  .empty-state code {
    background: var(--surface-muted);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .post-list {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-row {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }

  .post-row:hover {
    border-color: var(--brand);
  }

  .post-row img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .post-row-body h2 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .post-row-body p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
