---
import { createKenresoftClient } from '@kenresoft/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cms = createKenresoftClient({ url: import.meta.env.PUBLIC_KENRESOFT_CMS_URL });

// "blog-post" is this content type's slug, not its display name — set when it's created in
// the admin (Content types → New). Change this if your deployment uses a different slug, or
// if you're demonstrating a different content type entirely.
const entries = await cms.entries.list({ contentType: 'blog-post' });
---

<BaseLayout title="Blog">
  <h1>Blog</h1>

  {
    entries.length === 0 ? (
      <p>
        No published entries yet for the <code>blog-post</code> content type. Create one in the
        admin, publish it, then rebuild this site.
      </p>
    ) : (
      <ul>
        {entries.map((entry) => {
          const title = String(entry.data.title ?? entry.slug);
          return (
            <li>
              {typeof entry.data.featuredImage === 'string' ? (
                // Media's own altText (set on upload in the admin) isn't exposed by the
                // public API — only the file bytes are (§14/docs/ASTRO.md). Falling back to
                // the entry's title is an imperfect but honest stand-in; a real deployment
                // wanting real per-image alt text would need a small public media-metadata
                // endpoint, which is future work, not built here.
                <img src={cms.media.url({ id: entry.data.featuredImage })} alt={title} width="320" />
              ) : null}
              <a href={`/blog/${entry.slug}`}>{title}</a>
              {entry.data.excerpt ? <p>{String(entry.data.excerpt)}</p> : null}
            </li>
          );
        })}
      </ul>
    )
  }
</BaseLayout>
