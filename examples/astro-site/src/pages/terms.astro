---
import BaseLayout from '../layouts/BaseLayout.astro';
// Same deliberate non-CMS-backed placeholder as privacy.astro — see its own comment.
---

<BaseLayout title="Terms of Service — Kenresoft CMS" noIndex>
  <article class="legal">
    <h1>Terms of Service</h1>
    <p class="legal-note">
      Placeholder demo content, not backed by the CMS — see the Privacy Policy page's own note
      for why.
    </p>
    <p>
      Orders placed through this reference storefront are processed by the Commerce plugin's
      real checkout and payment flow; a production deployment should replace this page with its
      own actual terms covering payment, fulfillment, and returns.
    </p>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    line-height: 1.7;
  }

  .legal-note {
    padding: 0.85rem 1rem;
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>
