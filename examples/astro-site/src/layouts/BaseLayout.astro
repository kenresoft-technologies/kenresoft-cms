---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">Kenresoft CMS example</a>
      <nav><a href="/blog">Blog</a></nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
