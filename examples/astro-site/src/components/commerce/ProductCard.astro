---
import { formatMoney } from '../../lib/money';
import type { CommerceProduct } from '@kenresoft-cms/astro';

interface Props {
  product: CommerceProduct;
  /** First image URL, when this product has one — the list route doesn't return images (see public.ts), so a caller with a lookup can pass one in; otherwise a plain placeholder renders. */
  imageUrl?: string | null;
}

const { product, imageUrl } = Astro.props;
---

<a class="product-card" href={`/shop/${product.slug}`}>
  <div class="product-image">
    {imageUrl ? <img src={imageUrl} alt={product.name} loading="lazy" /> : <div class="product-image-placeholder" aria-hidden="true" />}
  </div>
  <div class="product-body">
    <h3>{product.name}</h3>
    {product.shortDescription ? <p>{product.shortDescription}</p> : null}
    <p class="product-price">{formatMoney(product.basePrice, product.currency)}</p>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .product-card:hover {
    border-color: var(--brand);
  }

  .product-image {
    aspect-ratio: 4 / 3;
    background: var(--surface-muted);
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--surface-muted), var(--border));
  }

  .product-body {
    padding: 1rem 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .product-body h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .product-body p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .product-price {
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--ink);
  }
</style>
