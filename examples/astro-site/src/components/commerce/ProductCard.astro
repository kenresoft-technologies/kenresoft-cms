---
import { formatMoney } from '../../lib/money';
import type { CommerceProduct } from '@kenresoft-cms/astro';

interface Props {
  product: CommerceProduct;
  /** First image URL, when this product has one — the list route doesn't return images (see public.ts), so a caller with a lookup can pass one in; otherwise a plain placeholder renders. */
  imageUrl?: string | null;
}

const { product, imageUrl } = Astro.props;
---

<a class="product-card card-hoverable" href={`/shop/${product.slug}`}>
  <div class="product-image">
    {imageUrl ? <img src={imageUrl} alt={product.name} loading="lazy" /> : <div class="product-image-placeholder" aria-hidden="true" />}
  </div>
  <div class="product-body">
    <h3>{product.name}</h3>
    {product.shortDescription ? <p>{product.shortDescription}</p> : null}
    <p class="product-price">{formatMoney(product.basePrice, product.currency)}</p>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
  }

  .product-image {
    aspect-ratio: 4 / 3;
    background: var(--surface-muted);
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.04);
  }

  .product-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--surface-muted), var(--border));
  }

  .product-body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .product-body h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .product-body p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .product-price {
    margin-top: var(--space-1);
    font-weight: 600;
    color: var(--ink);
  }
</style>
