---
// Renders a `rich_text` field's stored value, which is always an HTML string produced by the
// admin's Tiptap editor (CLAUDE.md's Tiptap entry — content is "stored and returned as an HTML
// string"). set:html is the same trust boundary docs/ASTRO.md's own blog example already
// establishes: reachable only once an authenticated CMS editor has written it, never
// user-submitted input.
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<div class="rich-text" set:html={html} />

<style>
  .rich-text :global(p) {
    margin: 0 0 1.1em;
    line-height: 1.7;
  }

  .rich-text :global(h2) {
    margin: 1.75em 0 0.6em;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .rich-text :global(h3) {
    margin: 1.5em 0 0.5em;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    margin: 0 0 1.1em;
    padding-left: 1.4em;
    line-height: 1.7;
  }

  .rich-text :global(blockquote) {
    margin: 1.25em 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--ink-muted);
  }

  .rich-text :global(a) {
    color: var(--brand);
    text-decoration: underline;
  }

  .rich-text :global(img) {
    border-radius: var(--radius);
    margin: 1.25em 0;
  }

  .rich-text :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25em 0;
  }

  .rich-text :global(td),
  .rich-text :global(th) {
    border: 1px solid var(--border);
    padding: 0.5em 0.7em;
  }

  .rich-text :global(code) {
    background: var(--surface-muted);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .rich-text :global(pre) {
    background: var(--surface-muted);
    padding: 1em;
    border-radius: var(--radius);
    overflow-x: auto;
  }
</style>
