---
import { createServerClient } from '../../lib/site-client';

// SSR: forwards the incoming request's own cookies to the CMS API to get the real cart count on
// first paint (the guest-cart cookie is set on the FIRST add-to-cart, which — unlike the customer
// session — genuinely can be same-site with the Astro app if a deployment chooses to route
// through it; where it isn't, this just comes back empty and cart-badge.ts's client-side refresh
// catches up). Customer identity is NOT trusted from this SSR call — see lib/account-guard.ts's
// comment: on a cross-origin deployment (the common case) the customer session cookie is set
// directly by the browser's own fetch to the CMS API, so it lands on the API's own origin and
// never reaches this SSR request's cookie header at all, making createServerClient always see a
// signed-in visitor as a guest. Both the guest and signed-in nav markup are rendered up front
// below; the inline script picks the right one client-side, where the check is actually reliable.
const cms = createServerClient(Astro.request.headers.get('cookie'));

let cartCount = 0;

try {
  const cart = await cms.commerce.cart.get();
  cartCount = cart.items.reduce((sum, item) => sum + item.quantity, 0);
} catch {
  // Commerce may be disabled/unreachable on some deployments — the header still renders, just
  // without cart state, rather than failing the whole page.
}
---

<header class="site-header">
  <a href="/" class="brand">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
        <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
        <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
      </svg>
    </span>
    Kenresoft CMS
  </a>

  <nav class="site-nav" aria-label="Primary">
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
    <a href="/shop">Shop</a>
    <a href="/cart" class="cart-link">
      Cart
      <span data-cart-count class="cart-count" hidden={cartCount === 0}>{cartCount}</span>
    </a>
    <a href="/account/login" data-guest-nav>Log in</a>
    <a href="/account" data-customer-nav hidden>Account (<span data-customer-name></span>)</a>
    <a href="/account/orders" data-customer-nav hidden>Orders</a>
    <button type="button" data-logout-button data-customer-nav hidden class="link-button">Log out</button>
  </nav>

  <a href="/cart" class="cart-link cart-link-mobile" aria-label={`Cart, ${cartCount} item${cartCount === 1 ? '' : 's'}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span data-cart-count class="cart-count" hidden={cartCount === 0}>{cartCount}</span>
  </a>

  <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
</header>

<div id="mobile-nav" class="mobile-nav" data-mobile-nav hidden>
  <nav aria-label="Primary, mobile">
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
    <a href="/shop">Shop</a>
    <a href="/cart">Cart{cartCount > 0 ? ` (${cartCount})` : ''}</a>
    <a href="/account/login" data-guest-nav>Log in</a>
    <a href="/account" data-customer-nav hidden>Account (<span data-customer-name></span>)</a>
    <a href="/account/orders" data-customer-nav hidden>Orders</a>
    <button type="button" data-logout-button data-customer-nav hidden class="link-button mobile-link-button">Log out</button>
  </nav>
</div>

<script>
  import { getBrowserClient } from '../../lib/browser-client';
  import { getCustomerClientSide } from '../../lib/account-guard';

  document.querySelectorAll<HTMLButtonElement>('[data-logout-button]').forEach((button) => {
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        await getBrowserClient().commerce.customerAuth.logout();
      } finally {
        window.location.href = '/';
      }
    });
  });

  // The nav renders in its signed-out state by default (see the frontmatter comment above for
  // why SSR can't reliably know better) — corrected here via a real client-side check, which is
  // the only place this can actually be answered correctly.
  getCustomerClientSide().then((customer) => {
    if (!customer) return;
    document.querySelectorAll<HTMLElement>('[data-guest-nav]').forEach((el) => (el.hidden = true));
    document.querySelectorAll<HTMLElement>('[data-customer-nav]').forEach((el) => (el.hidden = false));
    document.querySelectorAll<HTMLElement>('[data-customer-name]').forEach((el) => {
      el.textContent = customer.name.split(' ')[0] ?? customer.name;
    });
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobileNav = document.querySelector<HTMLDivElement>('[data-mobile-nav]');

  function closeMenu() {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    mobileNav.hidden = true;
    document.body.classList.remove('mobile-nav-open');
  }

  function openMenu() {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    mobileNav.hidden = false;
    document.body.classList.add('mobile-nav-open');
  }

  toggle?.addEventListener('click', () => {
    if (toggle.getAttribute('aria-expanded') === 'true') closeMenu();
    else openMenu();
  });

  // Closing on link click covers same-page navigations too (Astro's own client-side
  // navigation, when it kicks in) — without this the panel would still be open in the DOM
  // after the URL changes.
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  // A resize past the breakpoint (rotating a tablet, or a dev-tools viewport change) shouldn't
  // leave the panel open underneath the now-restored desktop nav.
  window.addEventListener('resize', () => {
    if (window.innerWidth > 720) closeMenu();
  });
</script>

<style>
  .site-nav {
    align-items: center;
  }

  .cart-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 var(--space-2);
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-foreground);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .link-button {
    border: none;
    background: none;
    padding: 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .link-button:hover {
    color: var(--ink);
  }

  /* Mobile-only affordances — the cart icon (so it's always one tap away, not buried in the
     menu) and the hamburger toggle. Hidden on desktop, where the full .site-nav already
     covers both. */
  .cart-link-mobile,
  .nav-toggle {
    display: none;
  }

  .nav-toggle {
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-toggle:hover {
    background: var(--surface-muted);
    border-color: var(--border-strong);
  }

  .nav-toggle svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .mobile-nav {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    /* Slides in from under the sticky header rather than just popping into view. */
    animation: mobile-nav-in 0.18s ease;
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav {
      animation: none;
    }
  }

  .mobile-nav nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
  }

  .mobile-nav nav a,
  .mobile-link-button {
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 600;
    text-align: left;
  }

  .mobile-nav nav a:last-of-type {
    border-bottom: none;
  }

  .mobile-link-button {
    border-bottom: none;
    color: var(--danger);
  }

  @media (max-width: 720px) {
    .site-header {
      padding: var(--space-4);
    }

    .site-nav {
      display: none;
    }

    .cart-link-mobile {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      width: 2.25rem;
      height: 2.25rem;
      color: var(--ink);
    }

    .cart-link-mobile svg {
      width: 1.35rem;
      height: 1.35rem;
    }

    .cart-link-mobile .cart-count {
      position: absolute;
      top: -0.3rem;
      right: -0.3rem;
      min-width: 1.1rem;
      height: 1.1rem;
      font-size: 0.65rem;
      padding: 0 0.3rem;
    }

    .nav-toggle {
      display: inline-flex;
      margin-left: var(--space-2);
    }
  }
</style>
