---
const REPO_URL = 'https://github.com/kenresoft-technologies/kenresoft-cms';
---

<footer class="site-footer">
  <div class="footer-columns">
    <div class="footer-column">
      <p class="footer-heading">Kenresoft CMS</p>
      <p>A reusable, open-source, Cloudflare-native content and commerce platform.</p>
      <p><a href={REPO_URL} target="_blank" rel="noreferrer">Source on GitHub →</a></p>
    </div>
    <div class="footer-column">
      <p class="footer-heading">Site</p>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </div>
    <div class="footer-column">
      <p class="footer-heading">Shop</p>
      <a href="/shop">All products</a>
      <a href="/cart">Cart</a>
    </div>
    <div class="footer-column">
      <p class="footer-heading">Account</p>
      <a href="/account">Dashboard</a>
      <a href="/account/orders">Orders</a>
      <a href="/account/login">Log in</a>
    </div>
    <div class="footer-column">
      <p class="footer-heading">Legal</p>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </div>
  </div>
  <p class="footer-note">Kenresoft CMS — reference storefront. MIT licensed.</p>
</footer>

<style>
  .site-footer {
    display: block;
    padding: 3rem 1.5rem 2.5rem;
  }

  .footer-columns {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr repeat(4, 1fr);
    gap: 2rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-heading {
    margin: 0 0 0.25rem;
    font-weight: 600;
    color: var(--ink);
  }

  .footer-note {
    max-width: var(--max-width);
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 720px) {
    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
