---
// The built-in "hero" block renderer — Phase 7 of the schema-driven frontend work
// (docs/SITE_BUILDER.md). Config shape mirrors HERO_BLOCK_CONFIG
// (packages/contracts/schemas/blocks.ts) exactly; every field is optional, so a
// just-added-and-not-yet-filled-in block still renders something sensible rather than blank.
import type { BlockInstance, KenresoftClient } from '@kenresoft-cms/astro';

interface Props {
  config: BlockInstance['config'];
  cms: KenresoftClient;
}

const { config, cms } = Astro.props;
const heading = typeof config.heading === 'string' ? config.heading : null;
const subheading = typeof config.subheading === 'string' ? config.subheading : null;
const imageMediaId = typeof config.imageMediaId === 'string' ? config.imageMediaId : null;
const ctaLabel = typeof config.ctaLabel === 'string' ? config.ctaLabel : null;
const ctaUrl = typeof config.ctaUrl === 'string' ? config.ctaUrl : null;
const imageUrl = imageMediaId ? cms.media.url({ id: imageMediaId }) : null;
---

<section class="hero-block">
  {imageUrl ? <img class="hero-image" src={imageUrl} alt="" /> : null}
  <div class="hero-content">
    {heading ? <h1>{heading}</h1> : null}
    {subheading ? <p class="hero-subheading">{subheading}</p> : null}
    {ctaLabel && ctaUrl ? (
      <a class="hero-cta" href={ctaUrl}>
        {ctaLabel}
      </a>
    ) : null}
  </div>
</section>

<style>
  .hero-block {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--surface-muted);
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--measure);
  }

  .hero-content h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hero-subheading {
    margin: 0 0 var(--space-6);
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .hero-cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius);
    background: var(--brand);
    color: var(--brand-foreground);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .hero-cta:hover {
    background: var(--brand-hover);
  }
</style>
