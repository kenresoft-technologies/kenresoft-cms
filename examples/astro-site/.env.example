PUBLIC_KENRESOFT_CMS_URL=http://localhost:8787

# Optional: renders a Cloudflare Turnstile widget on /account/register (a bot check on public
# sign-up). You normally don't need to set this here at all — if the CMS deployer set
# TURNSTILE_SITE_KEY on the API (`pnpm run setup` / `pnpm run update -- --turnstile`), this page
# fetches it automatically via `cms.system.status()`. Only set PUBLIC_TURNSTILE_SITE_KEY here to
# override that (e.g. a different widget for this frontend specifically). Either way, also set
# TURNSTILE_SECRET_KEY on the API for the bot check to actually be enforced (see
# docs/DEPLOYMENT.md). Leave everything unset and sign-up stays open with no human check.
# PUBLIC_TURNSTILE_SITE_KEY=
