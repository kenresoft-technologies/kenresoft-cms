PUBLIC_KENRESOFT_CMS_URL=http://localhost:8787

# Optional: renders a Cloudflare Turnstile widget on /account/register (a bot check on public
# sign-up). Create your own widget at dash.cloudflare.com -> Turnstile for this site's domain(s)
# and paste its *site key* here (public, safe to commit to a fork's own deploy config — never
# the secret key). Also set the matching secret key on the API:
# `wrangler secret put TURNSTILE_SECRET_KEY` (see docs/DEPLOYMENT.md). Leave both unset and
# sign-up stays open with no human check.
# PUBLIC_TURNSTILE_SITE_KEY=
