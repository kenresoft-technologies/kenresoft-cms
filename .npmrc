# apps/admin depends on @kenresoft-cms/contracts by a real published semver range (not the
# workspace: protocol) so it stays installable as a standalone clone outside this monorepo
# (see apps/admin/README.md) — this setting is what makes pnpm still link the local workspace
# package for day-to-day monorepo development instead of fetching from the registry every time.
link-workspace-packages=true
